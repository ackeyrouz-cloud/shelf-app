{
  "expo": {
    "name": "Shelf",
    "slug": "shelf-meal-planner",
    "version": "1.0.0",
    "scheme": "shelf",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.shelf",
      "infoPlist": {
        "NSCameraUsageDescription": "Shelf uses your camera to identify ingredients on your shelf so you don't have to type them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      },
      "package": "com.yourname.shelf",
      "permissions": [
        "CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "YOUR-EAS-PROJECT-ID"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
